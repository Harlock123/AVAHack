// The 14 conditions (spec 6.4). "save" is the attribute that may end it every 3 s; null seconds lasts until cured.
[
  { "id": "poisoned",   "name": "Poisoned",   "save": "con", "seconds": 12, "damagePerSecond": "1d2", "effects": ["attackDisadvantage"],
    "cures": ["antidote", "cleanse", "rest"], "text": "Poison burns in the blood: 1–2 damage a second and attacks at disadvantage." },
  { "id": "diseased",   "name": "Diseased",   "seconds": 1800, "effects": ["noRegen"],
    "cures": ["cleanse", "remedy"], "text": "No natural healing until cured. Rest doesn't help." },
  { "id": "bleeding",   "name": "Bleeding",   "save": "con", "seconds": 6, "damagePerSecond": "1d4",
