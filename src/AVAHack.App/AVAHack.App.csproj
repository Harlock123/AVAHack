<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>AVAHack</AssemblyName>
    <RootNamespace>AVAHack.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Avalonia loads XAML by reflection: never trim. -->
    <PublishTrimmed>false</PublishTrimmed>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="Silk.NET.OpenAL" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" />
  </ItemGroup>
  <ItemGroup>
    <!-- The sounds tools/make_sounds.py makes, embedded so the single-file build carries them. -->
    <EmbeddedResource Include="Assets\Sounds\*.wav" LogicalName="AVAHack.App.Sounds.%(Filename)%(Extension)" />
    <None Remove="Audio\native\**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\AVAHack.Core\AVAHack.Core.csproj" />
    <ProjectReference Include="..\AVAHack.Render\AVAHack.Render.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="AVAHack.App.Tests" />
  </ItemGroup>
</Project>
