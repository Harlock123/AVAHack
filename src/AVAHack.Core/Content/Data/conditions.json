  { "id": "stunned",    "name": "Stunned",    "save": "con", "seconds": 3, "effects": ["noActions", "attackedWithAdvantage"],
    "cures": ["cleanse"], "text": "Reeling: no actions, and easy to hit." },
  { "id": "asleep",     "name": "Asleep",     "save": "wis", "seconds": 20, "effects": ["noActions", "attackedWithAdvantage"],
    "cures": ["wake", "cleanse"], "text": "Asleep: no actions until woken by a hit or a shake." },
  { "id": "blinded",    "name": "Blinded",    "save": "con", "seconds": 10, "effects": ["attackDisadvantage", "attackedWithAdvantage"],
