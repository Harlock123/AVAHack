  { "id": "paralysed",  "name": "Paralysed",  "save": "con", "seconds": 6, "effects": ["noActions", "attackedWithAdvantage"],
    "cures": ["cleanse", "dispel"], "text": "Can't move or act." },
  { "id": "cursed",     "name": "Cursed",     "savePenalty": 2,
    "cures": ["dispel", "shrine"], "text": "−2 to every save, until the curse is lifted." },
  { "id": "weakened",   "name": "Weakened",   "save": "con", "seconds": 60, "strengthPenalty": 2,
    "cures": ["restore", "rest"], "text": "−2 to attacks and damage with STR." }
